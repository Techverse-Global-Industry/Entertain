{
  "name": "promote-by-techverse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build --configLoader runner",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test --test-concurrency=1 tests/api.test.mjs tests/hosting.test.mjs tests/professions.test.mjs tests/site-flow.test.mjs tests/cloud.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "test:experience": "node tests/experience.mjs",
    "setup": "node scripts/setup.mjs",
    "check": "node --check server/index.mjs && node --check server/core.mjs",
    "test:professions": "node tests/professions-browser.mjs",
    "test:site-flow": "node tests/site-flow-browser.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
