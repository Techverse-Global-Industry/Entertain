SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://YOUR_PROJECT.netlify.app
BASE_DOMAIN=YOUR_PROJECT.netlify.app
TENANT_ROUTING=path
NODE_ENV=production
TRUST_PROXY=1
VAPID_SUBJECT=mailto:tgidevs@gmail.com
AWS_LAMBDA_JS_RUNTIME=nodejs24.x
MEDIA_BUSINESS_BYTES=209715200
MEDIA_PROJECT_BYTES=838860800
