# Netlify site variables (set in Netlify, not in browser JavaScript):
# PROMOTE_BACKEND_URL=https://your-persistent-backend.example.com
# PROMOTE_PROXY_SECRET=<same 32+ character random value as the backend>
# Give PROMOTE_PROXY_SECRET both Builds and Runtime scopes in Netlify.

# Persistent backend environment:
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATA_DIR=/app/data
TRUST_PROXY=1
APP_URL=https://your-promote-site.netlify.app
BASE_DOMAIN=your-promote-site.netlify.app
TENANT_ROUTING=path
NETLIFY_SITE_ID=
PROMOTE_PROXY_SECRET=
VAPID_SUBJECT=mailto:tgidevs@gmail.com

# /app/data must be a mounted persistent volume. Keep the SQLite database,
# uploaded files and Web Push keys together when transferring existing data.
# No administrator password or private data belongs in the frontend build.
