PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# Production: your HTTPS origin and a domain owned by Techverse.
APP_URL=http://localhost:3000
BASE_DOMAIN=localhost
DATA_DIR=.data
# Set on first setup. Never use the example value in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional sender for web push. setup generates a persistent local VAPID keypair.
VAPID_SUBJECT=mailto:notifications@example.com
# Production requires NODE_ENV=production and HTTPS at your reverse proxy.
TRUST_PROXY=0
